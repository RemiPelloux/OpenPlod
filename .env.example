# Source-run backend only. Keep actual values in an ignored .env file.
# The native Mac app manages its own paths, service port, and pairing token.
HOST=127.0.0.1
PORT=3487
OPENPLOD_PAIRING_TOKEN=
# Optional separate API credential, accepted alongside the pairing token.
OPENPLOD_API_TOKEN=
# Optional absolute path to private named webhook destinations (mode 0600).
OPENPLOD_DESTINATIONS_FILE=

# Optional processing. Cloud providers receive audio or transcript text.
MISTRAL_API_KEY=
DEEPGRAM_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional absolute path to an already-authorized desktop identity.
# This does not obtain authorization or create a new identity.
OPENPLOD_DEVICE_IDENTITY=

# Experimental Android SDK only; these do not authorize desktop BLE.
# Never put developer secrets in the Android app or public repository.
PLAUD_CLIENT_ID=
PLAUD_CLIENT_SECRET=
PLAUD_USER_ID=openplod-owner
PLAUD_DEVELOPER_DOMAIN=platform-us.plaud.ai
